[32m+[m
[32m+[m[32m    except Exception:[m
[32m+[m[32m        return 30, "Clear"[m
[32m+[m
[32m+[m[32mdef fetch_weather_forecast():[m
[32m+[m
[32m+[m[32m    url = ([m
[32m+[m[32m        f"https://api.openweathermap.org/data/2.5/forecast?q={CITY}"[m
[32m+[m[32m        f"&appid={OPENWEATHER_API_KEY}&units=metric"[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    response = requests.get(url)[m
[32m+[m
[32m+[m[32m    data = response.json()[m
[32m+[m
[32m+[m[32m    forecast_list = data['list'][m
[32m+[m
[32m+[m[32m    weather_data = [][m
[32m+[m
[32m+[m[32m    for item in forecast_list[:10]:[m
[32m+[m
[32m+[m[32m        weather_data.append({[m
[32m+[m[32m            "datetime": item['dt_txt'],[m
[32m+[m[32m            "temperature": item['main']['temp'],[m
[32m+[m[32m            "humidity": item['main']['humidity'],[m
[32m+[m[32m            "condition": item['weather'][0]['main'][m
[32m+[m[32m        })[m
[32m+[m
[32m+[m[32m    return weather_data[m
[32m+[m
[32m+[m[32mdef fetch_real_energy_prices():[m
[32m+[m
[32m+[m[32m    url = ([m
[32m+[m[32m        f"https://api.eia.gov/v2/electricity/"[m
[32m+[m[32m        f"retail-sales/data/?api_key={EIA_API_KEY}"[m
[32m+[m[32m        f"&frequency=monthly"[m
[32m+[m[32m        f"&data[0]=price"[m
[32m+[m[32m        f"&sort[0][column]=period"[m
[32m+[m[32m        f"&sort[0][direction]=desc"[m
[32m+[m[32m        f"&offset=0&length=500"[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    response = requests.get(url)[m
[32m+[m
[32m+[m[32m    data = response.json()[m
[32m+[m
[32m+[m[32m    records = data['response']['data'][m
[32m+[m
[32m+[m[32m    df = pd.DataFrame(records)[m
[32m+[m[41m    [m
[32m+[m[32m    # print("Raw rows:", len(df))[m
[32m+[m[32m    # print(df["period"].nunique())[m
[32m+[m[32m    # print(df["period"].sort_values().unique()[:10])[m
[32m+[m[32m    # print(df["period"].sort_values().unique()[-10:])[m
[32m+[m[41m    [m
[32m+[m[32m    df = df[df["sectorName"] == "all sectors"][m
[32m+[m[41m    [m
[32m+[m[32m    df["price"] = pd.to_numeric([m
[32m+[m[32m        df["price"],[m
[32m+[m[32m        errors="coerce"[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    df["period"] = pd.to_datetime([m
[32m+[m[32m        df["period"],[m
[32m+[m[32m        format="%Y-%m"[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    df = ([m
[32m+[m[32m        df.groupby("period", as_index=False)[m
[32m+[m[32m        .agg({"price":"mean"})[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    return df[m
